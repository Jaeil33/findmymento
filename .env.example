# Supabase — 값이 비어 있으면 앱은 데모 데이터 모드로 동작한다 (읽기 전용).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두사를 절대 붙이지 말 것.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# QR이 가리킬 공개 도메인 (하드코딩 금지). Vercel에서는 배포 도메인을 넣는다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── RLS 네거티브 테스트 (선택) ────────────────────────────────────────────────
# 아래를 채우면 tests/rls-negative.live.test.ts 의 14개가 **실제 역할 키로** 실행된다.
# 비워 두면 건너뛴다. service_role 로는 RLS 를 우회하므로 의미가 없다 — 반드시 사용자 세션이다.
#
# 값은 supabase/seed.sql 을 적용하면 마지막 select 가 그대로 출력해 준다.
# 이메일·비밀번호 계정 2개는 Supabase 대시보드 Authentication → Users 에서 만든다.
RLS_TEST_ORG_A_EMAIL=
RLS_TEST_ORG_A_PASSWORD=
RLS_TEST_INSTRUCTOR_EMAIL=
RLS_TEST_INSTRUCTOR_PASSWORD=
RLS_TEST_ORG_B_ORG_ID=
RLS_TEST_UNASSIGNED_SESSION_ID=
RLS_TEST_CLOSED_SESSION_ID=
RLS_TEST_PENDING_INSTRUCTOR_ID=
RLS_TEST_EXPIRED_INVITE_TOKEN=
RLS_TEST_OTHER_INSTRUCTOR_ID=
